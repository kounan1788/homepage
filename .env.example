# 環境変数のサンプル（このファイルには本物の値を書かないこと）
# ローカルでは .env.local に、本番では Vercel の Settings → Environment Variables に設定する。
# 手順の詳細は docs/車検カレンダー運用手順書.md を参照。

# ── 車検受け入れ状況カレンダー（/shaken）──────────────────────
# サービスアカウントのメールアドレス（JSONキーの client_email）
GOOGLE_SERVICE_ACCOUNT_EMAIL=shaken-calendar-reader@your-project-id.iam.gserviceaccount.com
# サービスアカウントの秘密鍵（JSONキーの private_key を "-----BEGIN" から "-----END PRIVATE KEY-----\n" までそのまま貼る）
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nここに鍵\n-----END PRIVATE KEY-----\n"
# スプレッドシートのID（URLの /d/ と /edit の間の文字列）
SHAKEN_SHEET_ID=
# 任意：読み取る範囲（既定は '受け入れ状況'!A2:B。C列の社内メモは読まない）
# SHAKEN_SHEET_RANGE='受け入れ状況'!A2:B
# 任意：キャッシュ秒数（既定180秒。60〜300の範囲で指定）
# SHAKEN_CALENDAR_CACHE_SECONDS=180
